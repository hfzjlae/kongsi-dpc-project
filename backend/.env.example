# ============================================================
#  Copy this file to ".env" and fill in your own values.
#  NEVER commit the real .env file to GitHub (it holds secrets).
# ============================================================

# Port the API listens on
PORT=3000

# Public address of THIS API (used to build photo URLs in local mode)
PUBLIC_API_URL=http://localhost:3000

# Which website is allowed to call this API (CORS).
# Local: the address where you open the frontend (e.g. VS Code Live Server)
# AWS:   your S3 website URL or CloudFront URL. Separate several with commas.
CORS_ORIGIN=http://127.0.0.1:5500,http://localhost:5500

# ---------- Database (Tier 3) ----------
# Format: postgres://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kongsi
# Set to true on AWS RDS (RDS requires encrypted connections)
DB_SSL=false
# Max simultaneous DB connections held by this API instance
DB_POOL_MAX=10

# ---------- Security ----------
# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
# Max login/register attempts per IP per 15 minutes (0 = disabled)
AUTH_RATE_LIMIT=300

# ---------- Photo storage ----------
# "local" = save files on this computer (easy development)
# "s3"    = save files in an Amazon S3 bucket (use this on AWS)
STORAGE_MODE=local
MAX_UPLOAD_MB=5

# Only needed when STORAGE_MODE=s3
AWS_REGION=ap-southeast-1
S3_BUCKET=your-photo-bucket-name
# How long a photo link stays valid (seconds)
S3_URL_EXPIRES=3600
